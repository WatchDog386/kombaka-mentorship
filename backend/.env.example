# Copy this file to .env and change the values before real use.

# Secret used to sign login tokens. Use a long random string in production.
SECRET_KEY=change-me-to-a-long-random-string

# Where the SQLite database file lives (relative to the backend folder).
DATABASE=data/kengele.db

# How long a login lasts, in hours.
TOKEN_HOURS=12

# Passwords given to accounts the system creates automatically:
# a teacher account when a teaching staff member is added,
# a parent account when a learner is admitted (login = guardian phone).
TEACHER_DEFAULT_PASSWORD=teacher123
PARENT_DEFAULT_PASSWORD=parent123

# Show the demo accounts on the sign-in page. Set to 0 for real use.
SHOW_DEMO_ACCOUNTS=1

# Only needed when the frontend is served from another address
# (for example VS Code Live Server). Comma separated list.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

PORT=5000
